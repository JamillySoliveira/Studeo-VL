rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se o usuário é administrador
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'adm.vlautomacao@gmail.com'
      );
    }

    // Regra para usuários: aluno acessa seu perfil; admin visualiza todos
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Cursos, Módulos e Aulas: leitura permitida para todos autenticados, edição exclusiva para admin
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Progresso do aluno: o aluno acessa seu progresso; admin pode auditar
    match /progress/{progressId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin()
      );
    }
  }
}
